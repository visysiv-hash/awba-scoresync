{
  "name": "DrawNight",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "title": "Date"
    },
    "title": {
      "type": "string",
      "title": "Session Title"
    },
    "time_label": {
      "type": "string",
      "title": "Session Time"
    },
    "variant": {
      "type": "string",
      "title": "Draw Type",
      "enum": [
        "normal",
        "unique"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "normal"
    },
    "pairing_scope": {
      "type": "number",
      "title": "Pairing Method"
    },
    "courts_per_group": {
      "type": "number",
      "title": "Courts Per Group",
      "default": 2
    },
    "groups": {
      "type": "array",
      "title": "Groups",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "number",
            "title": "Group"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "courts": {
            "type": "array",
            "title": "Courts",
            "items": {
              "type": "number"
            }
          },
          "players": {
            "type": "array",
            "title": "Players",
            "items": {
              "type": "string"
            }
          },
          "top4": {
            "type": "array",
            "title": "Top 4",
            "items": {
              "type": "string"
            }
          },
          "bottom4": {
            "type": "array",
            "title": "Bottom 4",
            "items": {
              "type": "string"
            }
          },
          "average": {
            "type": "number",
            "title": "Group Average"
          }
        }
      }
    },
    "matches": {
      "type": "array",
      "title": "Matches",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "number",
            "title": "Group"
          },
          "game": {
            "type": "number",
            "title": "Game"
          },
          "net": {
            "type": "number",
            "title": "Court"
          },
          "team1": {
            "type": "array",
            "title": "Team 1",
            "items": {
              "type": "string"
            }
          },
          "team2": {
            "type": "array",
            "title": "Team 2",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "published": {
      "type": "boolean",
      "title": "Published",
      "default": true
    },
    "archived": {
      "type": "boolean",
      "title": "Removed From Schedule",
      "description": "Hidden from the Schedule page, but the night's games stay available so scores can still be entered.",
      "default": false
    }
  },
  "required": [
    "date"
  ]
}