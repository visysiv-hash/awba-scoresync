{
  "name": "DrawNight",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "title": "Date"
    },
    "title": {
      "type": "string",
      "title": "Session Title"
    },
    "time_label": {
      "type": "string",
      "title": "Session Time"
    },
    "variant": {
      "type": "string",
      "title": "Draw Type",
      "enum": [
        "normal",
        "unique"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "normal"
    },
    "pairing_scope": {
      "type": "number",
      "title": "Pairing Method"
    },
    "courts_per_group": {
      "type": "number",
      "title": "Courts Per Group",
      "default": 2
    },
    "groups": {
      "type": "array",
      "title": "Groups",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "number",
            "title": "Group"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "courts": {
            "type": "array",
            "title": "Courts",
            "items": {
              "type": "number"
            }
          },
          "players": {
            "type": "array",
            "title": "Players",
            "items": {
              "type": "string"
            }
          },
          "top4": {
            "type": "array",
            "title": "Top 4",
            "items": {
              "type": "string"
            }
          },
          "bottom4": {
            "type": "array",
            "title": "Bottom 4",
            "items": {
              "type": "string"
            }
          },
          "average": {
            "type": "number",
            "title": "Group Average"
          }
        }
      }
    },
    "matches": {
      "type": "array",
      "title": "Matches",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "number",
            "title": "Group"
          },
          "game": {
            "type": "number",
            "title": "Game"
          },
          "net": {
            "type": "number",
            "title": "Court"
          },
          "team1": {
            "type": "array",
            "title": "Team 1",
            "items": {
              "type": "string"
            }
          },
          "team2": {
            "type": "array",
            "title": "Team 2",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "published": {
      "type": "boolean",
      "title": "Published",
      "description": "Unpublished draws are drafts: players cannot see their games or enter scores until the draw is published.",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "title": "Removed From Schedule",
      "description": "Deleted from the Schedule. Its games disappear from Match Details and Results too, so nothing lingers without a draw.",
      "default": false
    },
    "american_doubles": {
      "type": "array",
      "title": "Happy To Play American Doubles",
      "description": "The players nominated for American doubles and singles when this night was drawn, so re-pairing the night keeps them in those games.",
      "items": {
        "type": "string"
      }
    },
    "last_groups_format": {
      "type": "string",
      "title": "Last Two Groups Format",
      "description": "How the night's last two groups play: ordinary doubles or American doubles (one against two).",
      "enum": [
        "doubles",
        "american",
        "singles"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple"
      ],
      "default": "doubles"
    },
    "singles_nets": {
      "type": "array",
      "title": "Singles Games On These Nets",
      "description": "The nets whose players share one block: each round those nets play as many doubles games as their players allow, and singles only for the games a doubles four cannot fill.",
      "items": {
        "type": "number"
      }
    },
    "extra_games": {
      "type": "array",
      "title": "Optional 4th Game",
      "description": "The mixed-grade games drawn for the players who opted in after the three scheduled games. They show in Match Details for that night only, are never scored and never count in results or rankings.",
      "items": {
        "type": "object",
        "properties": {
          "net": {
            "type": "number",
            "title": "Court"
          },
          "team1": {
            "type": "array",
            "title": "Team 1",
            "items": {
              "type": "string"
            }
          },
          "team2": {
            "type": "array",
            "title": "Team 2",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "extra_published": {
      "type": "boolean",
      "title": "4th Game Published",
      "description": "The optional 4th game only appears in Match Details once the admin publishes it.",
      "default": false
    }
  },
  "required": [
    "date"
  ]
}