{
  "name": "Booking",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "title": "Session ID"
    },
    "session_title": {
      "type": "string",
      "title": "Session Title"
    },
    "session_date": {
      "type": "string",
      "title": "Session Date"
    },
    "user_email": {
      "type": "string",
      "title": "User Email"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "booked_by_email": {
      "type": "string",
      "title": "Booked By Email"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "confirmed",
        "waitlisted",
        "cancelled"
      ]
    },
    "paid": {
      "type": "boolean",
      "title": "Paid",
      "default": false
    },
    "checked_in": {
      "type": "boolean",
      "title": "Checked In",
      "default": false
    },
    "checked_in_at": {
      "type": "string",
      "title": "Checked In At"
    },
    "fourth_game": {
      "type": "boolean",
      "title": "In For The 4th Game",
      "description": "Opted in to the optional 4th game after the three scheduled games. Just for fun: it is never scored and never counts in results or rankings.",
      "default": false
    }
  },
  "required": [
    "session_id",
    "user_email",
    "user_name",
    "status"
  ]
}