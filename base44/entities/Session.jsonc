{
  "name": "Session",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "date": {
      "type": "string",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "max_spots": {
      "type": "number",
      "title": "Max Spots"
    },
    "max_waitlist": {
      "type": "number",
      "title": "Max Waitlist Spots"
    },
    "payment_notes": {
      "type": "array",
      "title": "Payment Notes",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "title": "Payment Type",
            "enum": [
              "Pay on arrival",
              "Pay before arrival",
              "No payment required",
              "Other"
            ]
          },
          "amount": {
            "type": "number",
            "title": "Amount (AUD)"
          },
          "label": {
            "type": "string",
            "title": "Custom Label"
          }
        }
      }
    },
    "payment_required": {
      "type": "boolean",
      "title": "Payment Required"
    },
    "price": {
      "type": "number",
      "title": "Price (AUD)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title",
    "date",
    "start_time",
    "max_spots"
  ]
}