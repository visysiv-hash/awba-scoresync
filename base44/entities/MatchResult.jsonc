{
  "name": "MatchResult",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "title": "Date"
    },
    "round": {
      "type": "number",
      "title": "Round"
    },
    "game_id": {
      "type": "string",
      "title": "Game ID"
    },
    "net": {
      "type": "number",
      "title": "Net"
    },
    "game": {
      "type": "number",
      "title": "Game"
    },
    "team1": {
      "type": "string",
      "title": "Team 1"
    },
    "team2": {
      "type": "string",
      "title": "Team 2"
    },
    "team1_players": {
      "type": "array",
      "title": "Team 1 Players",
      "items": {
        "type": "string"
      }
    },
    "team2_players": {
      "type": "array",
      "title": "Team 2 Players",
      "items": {
        "type": "string"
      }
    },
    "score1": {
      "type": "number",
      "title": "Team 1 Score"
    },
    "score2": {
      "type": "number",
      "title": "Team 2 Score"
    },
    "rounds": {
      "type": "array",
      "title": "Rounds",
      "items": {
        "type": "object",
        "properties": {
          "score1": {
            "type": "number",
            "title": "Team 1"
          },
          "score2": {
            "type": "number",
            "title": "Team 2"
          }
        }
      }
    },
    "rating": {
      "type": "number",
      "title": "Game Rating (1\u20135)",
      "description": "Optional star rating from the players on how much they enjoyed this game."
    },
    "source": {
      "type": "string",
      "title": "Source",
      "enum": [
        "app",
        "sheet"
      ],
      "default": "app"
    }
  },
  "required": [
    "date",
    "score1",
    "score2"
  ]
}