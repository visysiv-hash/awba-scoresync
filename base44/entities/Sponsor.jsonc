{
  "name": "Sponsor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Sponsor Name"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "website_url": {
      "type": "string",
      "title": "Website URL"
    },
    "display_order": {
      "type": "number",
      "title": "Display Order"
    },
    "active": {
      "type": "boolean",
      "title": "Active"
    },
    "splash_only": {
      "type": "boolean",
      "title": "Splash Screen Only",
      "description": "Show this logo on the splash screen only, not in the home page scrolling strip.",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}