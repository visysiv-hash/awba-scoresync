  "description": "Every Thursday morning, any game from the week's session still without a score after the Wednesday 11:59pm deadline is recorded as no result, which applies the rating penalty to both pairs.",
  "name": "Close Unscored Games",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "close_unscored_games",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "close_unscored_games": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "closeUnscoredGames",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Close unscored games",
